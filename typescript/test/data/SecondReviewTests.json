{
 "RunawayTests.StopsInsteadOfHanging": [
  [
   "while :; do while :; do :; done; done; echo survived"
  ],
  [
   "f(){ f; f; }; f; echo survived"
  ],
  [
   "x='eval \"$x\"'; eval \"$x\"; echo survived"
  ],
  [
   "printf './a.sh\\n' > a.sh; chmod +x a.sh; ./a.sh; echo survived"
  ],
  [
   "echo a | sed ':a;s/x*/x/;ta'"
  ],
  [
   "jq -n '[range(1e10)] | length'"
  ],
  [
   "jq -n '[1|recurse(.+1)] | length'"
  ]
 ],
 "SchemaMapperReviewTests.SendsWhatWasMeant": [
  [
   "t run --tags 123",
   "{\"tags\":[\"123\"]}"
  ],
  [
   "t run --id abc",
   "{\"id\":\"abc\"}"
  ],
  [
   "t run --id 7",
   "{\"id\":7}"
  ],
  [
   "t run --level 1",
   "{\"level\":\"1\"}"
  ],
  [
   "t run --no-cache=true",
   "{\"cache\":false}"
  ],
  [
   "t run --title -h",
   "{\"title\":\"-h\"}"
  ],
  [
   "t run --limit 9 --json '{\"limit\":2,\"title\":\"x\"}'",
   "{\"limit\":9,\"title\":\"x\"}"
  ],
  [
   "t run --json '{\"tags\":[\"a\"]}' --tags b",
   "{\"tags\":[\"b\"]}"
  ]
 ],
 "DeepNestingTests.DeepNestingIsAnErrorNotACrash": [
