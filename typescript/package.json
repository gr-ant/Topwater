{
  "name": "topwater",
  "version": "0.1.0",
  "description": "A simulated bash shell for LLM agents: in-process interpreter, in-memory Ubuntu-like filesystem, ~100 standard commands.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "default": "./dist/integrations/ai-sdk.js"
    },
    "./openai-agents": {
      "types": "./dist/integrations/openai-agents.d.ts",
      "default": "./dist/integrations/openai-agents.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "default": "./dist/integrations/langchain.js"
    },
    "./mastra": {
      "types": "./dist/integrations/mastra.d.ts",
      "default": "./dist/integrations/mastra.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/integrations/claude-agent-sdk.d.ts",
      "default": "./dist/integrations/claude-agent-sdk.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p browser/tsconfig.json",
    "test": "vitest run",
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "@openai/agents": ">=0.22.0 <1",
    "@langchain/core": "^1.5.0",
    "@mastra/core": "^1.86.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.5.1",
    "@mastra/core": "^1.86.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.22.0",
    "@types/node": "^26.6.7",
    "ai": "^7.0.181",
    "esbuild": "^0.28.2",
    "langchain": "^1.6.8",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
