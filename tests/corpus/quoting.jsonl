{"id":"quoting-001","script":"echo \"$(echo \"inner \\\"quoted\\\" text\")\"","stdout":"inner \"quoted\" text\n","exitCode":0,"quiet":true}
{"id":"quoting-002","script":"x=\"a b\"; echo \"$(echo \"$x\" | tr a-z A-Z)\"","stdout":"A B\n","exitCode":0,"quiet":true}
{"id":"quoting-003","script":"echo \"a\\$b \\\\ \\` \\\"q\\\" \\n\"","stdout":"a$b \\ ` \"q\" \\n\n","exitCode":0,"quiet":true}
{"id":"quoting-004","script":"echo 'single \\n $x \"dq\"'","stdout":"single \\n $x \"dq\"\n","exitCode":0,"quiet":true}
{"id":"quoting-005","script":"cat <<EOF\nback\\\\slash \\$dollar \\`tick\\` \"q\" 'sq' \\n\nEOF","stdout":"back\\slash $dollar `tick` \"q\" 'sq' \\n\n","exitCode":0,"quiet":true}
{"id":"quoting-006","script":"x=1; cat <<EOF\nval=$x $(echo cmd) $((1+2)) ${x:-d}\nEOF","stdout":"val=1 cmd 3 1\n","exitCode":0,"quiet":true}
{"id":"quoting-007","script":"set -- \"a b\" c; for a in \"$@\"; do echo \"[$a]\"; done; for a in $*; do echo \"<$a>\"; done; for a in \"$*\"; do echo \"{$a}\"; done","stdout":"[a b]\n[c]\n<a>\n<b>\n<c>\n{a b c}\n","exitCode":0,"quiet":true}
{"id":"quoting-008","script":"set -- a b c; IFS=,; echo \"$*\"; echo $*; echo \"$@\"; unset IFS","stdout":"a,b,c\na b c\na b c\n","exitCode":0,"quiet":true}
{"id":"quoting-009","script":"set -- a b c; IFS=; echo \"$*\"; unset IFS","stdout":"abc\n","exitCode":0,"quiet":true}
{"id":"quoting-010","script":"f() { echo $#; }; f \"\" \"\"; f ''; f; e=; f $e; f \"$e\"","stdout":"2\n1\n0\n0\n1\n","exitCode":0,"quiet":true}
{"id":"quoting-011","script":"set -- x y; s=\"$@\"; echo \"$s\"; t=$@; echo \"$t\"","stdout":"x y\nx y\n","exitCode":0,"quiet":true}
{"id":"quoting-012","script":"IFS=: read -r a b c <<< \"1:2:3:4\"; echo \"$a|$b|$c\"","stdout":"1|2|3:4\n","exitCode":0,"quiet":true}
{"id":"quoting-013","script":"IFS=: read -r a b <<< \"1::3\"; echo \"$a|$b\"","stdout":"1|:3\n","exitCode":0,"quiet":true}
{"id":"quoting-014","script":"x=\"a:b::c\"; IFS=:; set -- $x; echo $#; unset IFS","stdout":"4\n","exitCode":0,"quiet":true}
{"id":"quoting-015","script":"x=\" a  b \"; IFS=' '; set -- $x; echo $#","stdout":"2\n","exitCode":0,"quiet":true}
{"id":"quoting-016","script":"x=\"a,b,,c,\"; IFS=,; arr=($x); echo ${#arr[@]}; unset IFS","stdout":"4\n","exitCode":0,"quiet":true}
{"id":"quoting-017","script":"x=\"a, b ,c\"; IFS=', '; arr=($x); echo ${#arr[@]} \"${arr[1]}\"","stdout":"3 b\n","exitCode":0,"quiet":true}
{"id":"quoting-018","script":"touch a.txt b.txt; x='*.txt'; echo $x; echo \"$x\"","stdout":"a.txt b.txt\n*.txt\n","exitCode":0,"quiet":true}
{"id":"quoting-019","script":"touch a.txt; set -f; echo *.txt; set +f; echo *.txt","stdout":"*.txt\na.txt\n","exitCode":0,"quiet":true}
{"id":"quoting-020","script":"echo nomatch*.zzz; shopt -s nullglob; echo nomatch*.zzz end","stdout":"nomatch*.zzz\nend\n","exitCode":0,"quiet":true}
{"id":"quoting-021","script":"touch .hidden vis; echo *; shopt -s dotglob; echo *","stdout":"vis\n.hidden vis\n","exitCode":0,"quiet":true}
{"id":"quoting-022","script":"shopt -s extglob; [[ abc == @(abc|def) ]] && echo m1; [[ xyz == !(abc) ]] && echo m2; [[ aaa == +(a) ]] && echo m3; [[ \"\" == ?(x) ]] && echo m4; [[ b == *(a|b) ]] && echo m5","stdout":"m1\nm2\nm3\nm4\nm5\n","exitCode":0,"quiet":true}
{"id":"quoting-023","script":"mkdir -p d/e; touch d/e/f.txt d/g.txt; shopt -s globstar; echo d/**/*.txt","stdout":"d/e/f.txt d/g.txt\n","exitCode":0,"quiet":true}
{"id":"quoting-024","script":"shopt -s nocasematch; [[ ABC == abc ]] && echo ci; case XyZ in xyz) echo case-ci;; esac","stdout":"ci\ncase-ci\n","exitCode":0,"quiet":true}
{"id":"quoting-025","script":"echo {a,b}{1,2}","stdout":"a1 a2 b1 b2\n","exitCode":0,"quiet":true}
{"id":"quoting-026","script":"echo {1..10..3} {a..e} {01..10} {10..1..4} {e..a}","stdout":"1 4 7 10 a b c d e 01 02 03 04 05 06 07 08 09 10 10 6 2 e d c b a\n","exitCode":0,"quiet":true}
{"id":"quoting-027","script":"echo pre{,.bak} file.{txt,md}","stdout":"pre pre.bak file.txt file.md\n","exitCode":0,"quiet":true}
{"id":"quoting-028","script":"echo \"{a,b}\" '{a,b}' {a} {} {a,b","stdout":"{a,b} {a,b} {a} {} {a,b\n","exitCode":0,"quiet":true}
{"id":"quoting-029","script":"x=1; echo {$x,2} {1..$x}","stdout":"1 2 {1..1}\n","exitCode":0,"quiet":true}
{"id":"quoting-030","script":"echo a{b,c{d,e}}f","stdout":"abf acdf acef\n","exitCode":0,"quiet":true}
{"id":"quoting-031","script":"echo {a..c}{1..2}","stdout":"a1 a2 b1 b2 c1 c2\n","exitCode":0,"quiet":true}
{"id":"quoting-032","script":"echo \\{a,b\\} \\* \\? \"*\"","stdout":"{a,b} * ? *\n","exitCode":0,"quiet":true}
{"id":"quoting-033","script":"echo {-1..2} {a..c..2}","stdout":"-1 0 1 2 a c\n","exitCode":0,"quiet":true}
{"id":"quoting-034","script":"echo x{1..3}y","stdout":"x1y x2y x3y\n","exitCode":0,"quiet":true}
{"id":"quoting-035","script":"echo $(( 1 + 2 ))\"$(echo a b)\"'c d'","stdout":"3a bc d\n","exitCode":0,"quiet":true}
{"id":"quoting-036","script":"echo \"It's\" 'He said \"hi\"' \"a'b\" 'a'\"'\"'b'","stdout":"It's He said \"hi\" a'b a'b\n","exitCode":0,"quiet":true}
{"id":"quoting-037","script":"echo a\\ b \"c\\ d\" 'e\\ f'","stdout":"a b c\\ d e\\ f\n","exitCode":0,"quiet":true}
{"id":"quoting-038","script":"echo \"$(printf '%s\\n' a b)\"; echo $(printf '%s\\n' a b)","stdout":"a\nb\na b\n","exitCode":0,"quiet":true}
{"id":"quoting-039","script":"v=$(printf 'x\\n\\n\\n'); echo \"[$v]\"","stdout":"[x]\n","exitCode":0,"quiet":true}
{"id":"quoting-040","script":"echo \"`echo \\`echo nested\\``\"","stdout":"nested\n","exitCode":0,"quiet":true}
{"id":"quoting-041","script":"echo $(echo $(echo deep))","stdout":"deep\n","exitCode":0,"quiet":true}
{"id":"quoting-042","script":"x='a  b'; echo $x; echo \"$x\"","stdout":"a b\na  b\n","exitCode":0,"quiet":true}
{"id":"quoting-043","script":"echo -n \"no newline\"; echo","stdout":"no newline\n","exitCode":0,"quiet":true}
{"id":"quoting-044","script":"echo -e 'a\\tb\\nc' ; echo -E 'a\\tb'; echo 'a\\tb'","stdout":"a\tb\nc\na\\tb\na\\tb\n","exitCode":0,"quiet":true}
{"id":"quoting-045","script":"echo -e '\\x41\\0101\\e[0m' | od -c | head -1","stdout":"0000000   A   A 033   [   0   m  \\n\n","exitCode":0,"quiet":true}
{"id":"quoting-046","script":"echo -- -n; echo -n -e 'x\\n'; echo -ne 'y\\n'; echo -x","stdout":"-- -n\nx\ny\n-x\n","exitCode":0,"quiet":true}
{"id":"quoting-047","script":"echo -e 'stop\\chere'; echo after","stdout":"stopafter\n","exitCode":0,"quiet":true}
{"id":"quoting-048","script":"printf '%s|' \"a b\" c; echo","stdout":"a b|c|\n","exitCode":0,"quiet":true}
{"id":"quoting-049","script":"v='a\"b'; echo \"$v\" \"${v}\" '$v'","stdout":"a\"b a\"b $v\n","exitCode":0,"quiet":true}
{"id":"quoting-050","script":"echo \"${PWD##*/}\" >/dev/null; echo ok","stdout":"ok\n","exitCode":0,"quiet":true}
{"id":"quoting-051","script":"x=$'line1\\nline2'; echo \"$x\"; echo $x","stdout":"line1\nline2\nline1 line2\n","exitCode":0,"quiet":true}
{"id":"quoting-052","script":"echo $((2#101)) \"$((16#ff))\" $((0x1F)) $((010)) $((36#z)) $((64#_))","stdout":"5 255 31 8 35 63\n","exitCode":0,"quiet":true}
{"id":"quoting-053","script":"a=\" x \"; [ \"$a\" = \" x \" ] && echo eq","stdout":"eq\n","exitCode":0,"quiet":true}
{"id":"quoting-054","script":"echo \"a\"'b'c\"d\"","stdout":"abcd\n","exitCode":0,"quiet":true}
{"id":"quoting-055","script":"unset e; echo \"${e}x\" ${e}y","stdout":"x y\n","exitCode":0,"quiet":true}
{"id":"quoting-056","script":"IFS=$'\\n'; lines=$(printf 'a b\\nc d'); for l in $lines; do echo \"[$l]\"; done; unset IFS","stdout":"[a b]\n[c d]\n","exitCode":0,"quiet":true}
{"id":"quoting-057","script":"v=\"one two\"; arr=(\"$v\" $v); echo ${#arr[@]}","stdout":"3\n","exitCode":0,"quiet":true}
{"id":"quoting-058","script":"echo '#not comment' a#b # real comment","stdout":"#not comment a#b\n","exitCode":0,"quiet":true}
{"id":"quoting-059","script":"echo a;echo b ; echo c","stdout":"a\nb\nc\n","exitCode":0,"quiet":true}
{"id":"quoting-060","script":"x=5 echo $x; x=5; echo $x","stdout":"\n5\n","exitCode":0,"quiet":true}
{"id":"quoting-061","script":"echo $((1+1)) $[1+1]","stdout":"2 2\n","exitCode":0,"quiet":true}
