{"id":"shell-syntax-007","script":"echo $(echo inner) `echo tick`","stdout":"inner tick\n","exitCode":0,"quiet":null}
{"id":"shell-syntax-008","script":"echo \"$(printf 'a  b')\"","stdout":"a  b\n","exitCode":0,"quiet":null}
{"id":"shell-syntax-009","script":"true && echo yes || echo no","stdout":"yes\n","exitCode":0,"quiet":null}
{"id":"shell-syntax-010","script":"false && echo yes || echo no","stdout":"no\n","exitCode":0,"quiet":null}
{"id":"shell-syntax-011","script":"false; echo $?","stdout":"1\n","exitCode":0,"quiet":null}
{"id":"shell-syntax-012","script":"! false && echo negated","stdout":"negated\n","exitCode":0,"quiet":null}
