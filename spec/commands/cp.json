{
  "$schema": "../command.schema.json",
  "name": "cp",
  "category": "file",
  "summary": "Make copies of files or whole directory trees",
  "parser": "args",
  "options": [
    {"short": "a", "description": "copy recursively, keeping modes and times"},
    {"long": ["archive"], "key": "a", "description": "copy recursively, keeping modes and times", "ports": ["ts"]},
    {"short": "f", "long": ["force"], "description": "overwrite without asking"},
    {"short": "i", "description": "ask before overwriting (no terminal: never overwrite)", "ports": ["ts"]},
    {"short": "d", "description": "copy symbolic links as links"},
    {"short": "H", "description": "follow symbolic links named on the command line"},
    {"short": "L", "long": ["dereference"], "description": "follow every symbolic link"},
    {"short": "n", "description": "never overwrite an existing file"},
    {"long": ["no-clobber"], "key": "n", "description": "never overwrite an existing file", "ports": ["ts"]},
    {"short": "p", "description": "keep modes and times"},
    {"short": "P", "long": ["no-dereference"], "description": "copy symbolic links as links, never following them"},
    {"short": "R", "description": "copy directories recursively"},
    {"short": "r", "long": ["recursive"], "description": "copy directories recursively"},
    {"short": "T", "long": ["no-target-directory"], "description": "treat the destination as a normal file", "ports": ["ts"]},
    {"short": "t", "long": ["target-directory"], "arg": "DIRECTORY", "description": "copy or move everything into DIRECTORY", "ports": ["ts"]},
    {"long": ["verbose"], "key": "v", "description": "report each file", "ports": ["ts"]},
    {"short": "v", "description": "report each file"},
    {"short": "Z", "description": "accepted and ignored (no SELinux)", "ignored": true}
  ],
  "messages": {
    "missingDestination": "missing destination file operand after {file:shell-always}",
    "cannotStat": "cannot stat '{file}': {errno}",
    "targetFailed": "target '{file}': {errno}",
    "sameFile": "{source:shell-always} and {dest:shell-always} are the same file",
    "overwriteNonDirectory": "cannot overwrite non-directory {dest:shell-always} with directory {source:shell-always}",
    "overwriteDirectory": "cannot overwrite directory {dest:shell-always} with non-directory",
    "errorWriting": "error writing '{file}': {errno}",
    "omittingDirectory": "-r not specified; omitting directory '{file}'",
    "danglingSymlink": "not writing through dangling symlink '{file}'",
    "intoItself": "cannot copy a directory, {source:shell-always}, into itself, {dest:shell-always}",
    "intoItselfPlain": "cannot copy a directory, '{source}', into itself, '{dest}'",
    "cannotAccess": "cannot access '{file}': {errno}",
    "cannotOpen": "cannot open '{file}' for reading: {errno}",
    "cyclicLink": "cannot copy cyclic symbolic link '{file}'",
    "cannotCreate": "cannot create {kind} '{file}': {errno}"
  }
}
