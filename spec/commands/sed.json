{
  "$schema": "../command.schema.json",
  "name": "sed",
  "category": "text",
  "summary": "Stream editor",
  "version": "sed (GNU sed) 4.9",
  "help": [
    "Usage: sed [OPTION]... {script-only-if-no-other-script} [input-file]...",
    "Run a script of editing commands over each line of the input and print the result.",
    "",
    "  -n, --quiet, --silent    print only what the script prints (p, s///p, ...)",
    "  -e script, --expression=script",
    "                           add the commands in script",
    "  -f script-file, --file=script-file",
    "                           add the commands in a file",
    "  -i[SUFFIX], --in-place[=SUFFIX]",
    "                           write the result back into each file; with SUFFIX,",
    "                           keep the original under the name FILE+SUFFIX",
    "  -E, -r, --regexp-extended",
    "                           read regular expressions as POSIX extended ones",
    "  -s, --separate           treat each file as its own input, not one stream",
    "  -u, --unbuffered         accepted, no effect",
    "      --debug, --posix, --sandbox, --follow-symlinks",
    "                           accepted, no effect",
    "      --help               show this help",
    "      --version            show the version",
    "",
    "Without -e or -f, the first operand is the script. The other operands are",
    "input files; with none, sed reads standard input."
  ],
  "parser": "custom",
  "options": [
    {"short": "n", "long": ["quiet", "silent"], "description": "print only what the script prints"},
    {"short": "e", "long": ["expression"], "arg": "SCRIPT", "description": "add the commands in SCRIPT"},
    {"short": "f", "long": ["file"], "arg": "FILE", "description": "add the commands in FILE"},
    {"short": "i", "long": ["in-place"], "description": "write the result back into each file (-iSUFFIX keeps a backup)"},
    {"short": "E", "long": ["regexp-extended"], "description": "read patterns as POSIX extended regexes"},
    {"short": "r", "description": "same as -E"},
    {"short": "s", "long": ["separate"], "description": "treat each file as its own input"},
    {"short": "u", "long": ["unbuffered"], "description": "accepted and ignored", "ignored": true},
    {"long": ["debug", "posix", "sandbox", "follow-symlinks"], "key": "\u0001", "description": "accepted and ignored", "ignored": true}
  ],
  "messages": {
    "openFailed": "can't read {file}: {errno}",
    "readDirectory": "read error on {file}: {errno}",
    "unterminatedAddress": "unterminated address regex",
    "unterminatedY": "unterminated `y' command",
    "unterminatedS": "unterminated `s' command",
    "noPreviousRegex": "no previous regular expression",
    "expectedBackslash": "expected \\ after `a', `c' or `i'",
    "unexpectedComma": "unexpected `,'",
    "lineZero": "invalid usage of line address 0",
    "multipleBang": "multiple `!'s",
    "missingCommand": "missing command",
    "unexpectedBrace": "unexpected `}'",
    "braceAddresses": "} doesn't want any addresses",
    "multipleNumbers": "multiple number options to `s' command",
    "zeroNumber": "number option to `s' command may not be zero",
    "multipleG": "multiple `g' options to `s' command",
    "multipleP": "multiple `p' options to `s' command",
    "missingFilename": "missing filename in r/R/w/W commands",
    "unknownSOption": "unknown option to `s'",
    "yLengths": "strings for `y' command are different lengths",
    "colonAddresses": ": doesn't want any addresses",
    "colonLabel": "\":\" lacks a label",
    "extraCharacters": "extra characters after command",
    "unmatchedBrace": "unmatched `{'",
    "noInputFiles": "no input files",
    "tooManySteps": "too many steps (a branch loops forever?)",
    "invalidRegex": "invalid regular expression: {detail}",
    "flagNotSupported": "the `{flag}' flag of `s' is not supported",
    "invalidReference": "invalid reference \\{number} on `s' command's RHS",
    "unknownCommand": "unknown command: `{op}'",
    "missingLabel": "can't find label for jump to `{label}'",
    "cannotOpenScript": "couldn't open file {file}: {errno}",
    "notRegularFile": "couldn't edit {file}: not a regular file"
  },
  "notes": "help is also printed after a usage error, as GNU sed prints its usage there."
}
