{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/topwater/spec/topwater-file/history.schema.json",
  "title": "Topwater history line",
  "description": "One line of history.jsonl in a .topwater file: the first line is the header, every later line one call, in order.",
  "oneOf": [{ "$ref": "#/$defs/header" }, { "$ref": "#/$defs/call" }],
  "$defs": {
    "header": {
      "type": "object", "required": ["format", "version", "options"],
      "properties": {
        "format": { "const": "topwater-history" },
        "version": { "type": "integer", "minimum": 1, "maximum": 1, "description": "A reader refuses a newer version than it knows." },
        "created": { "$ref": "manifest.schema.json#/$defs/time" },
        "topwater": { "type": "string", "description": "The Topwater that wrote it (informational): a version, or the port's name." },
        "options": {
          "type": "object", "description": "The shell's options. A reader uses the limits only to lower its own, never to raise them.",
          "properties": {
            "user": { "$ref": "manifest.schema.json#/$defs/userName" },
            "hostname": { "type": "string" },
            "startTime": { "$ref": "manifest.schema.json#/$defs/time", "description": "The virtual clock's start; with randomSeed the run is deterministic." },
            "randomSeed": { "type": "integer" },
            "maxLoopIterations": { "type": "integer", "minimum": 0 },
            "maxExtractBytes": { "type": "integer", "minimum": 0 },
            "maxExtractEntries": { "type": "integer", "minimum": 0 },
            "maxCallDurationMs": { "type": "integer", "minimum": -1, "description": "-1: no limit." },
            "maxFileSystemBytes": { "type": "integer", "minimum": 0 },
            "maxStringBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "appCommands": { "type": "array", "items": { "type": "string" }, "description": "The app's own commands the shell had; a replay needs them registered." },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Free-form facts: model, task, harness, ..." },
        "web": {
          "type": "object", "description": "The web policy the shell had (Shell.AllowWeb), without the credentials' values or a handler.",
          "properties": {
            "domains": { "type": "array", "items": { "type": "string" } },
            "methods": { "type": "array", "items": { "type": "string" } },
            "allowHttp": { "type": "boolean" },
            "maxResponseBytes": { "type": "integer", "minimum": 0 },
            "maxRequestsPerCall": { "type": "integer", "minimum": 0 },
            "maxRequests": { "type": "integer", "minimum": 0 },
            "timeoutMs": { "type": "integer", "minimum": 0 },
            "maxRedirects": { "type": "integer", "minimum": 0 },
            "explainBlocked": { "type": "boolean" },
            "credentials": { "type": "array", "items": { "type": "string" }, "description": "Hosts that had a credential; never the value." }
          }
        },
        "mounts": {
          "type": "array", "items": { "$ref": "#/$defs/mountExchange" },
          "description": "What the mounts held when recording started, as the listings and reads a replay's first listing and fetches answer from."
        }
      }
    },
    "call": {
      "type": "object", "required": ["index", "command", "stdout", "stderr", "exitCode"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "0 for the first call, then 1, 2, ..." },
        "command": { "type": "string" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "exitCode": { "type": "integer" },
        "trailer": { "type": "string", "description": "The note a limit added (time limit, output cut), when there was one." },
        "elapsedMs": { "type": "number", "minimum": 0, "maximum": 1000000000000, "description": "Wall time; informational, never compared." },
        "time": { "$ref": "manifest.schema.json#/$defs/time", "description": "The shell's clock when the call started (the virtual clock on a deterministic shell)." },
        "files": {
          "type": "array", "items": { "$ref": "manifest.schema.json#/$defs/path" }, "uniqueItems": true,
          "description": "Paths the call added, changed or removed (content, type, mode, owner, mtime or link), sorted. Left out when none."
        },
        "web": {
          "type": "array", "items": { "$ref": "#/$defs/exchange" },
          "description": "The requests the call made, in order, and what came back; a replay serves these instead of the network."
        },
        "mounts": {
          "type": "array", "items": { "$ref": "#/$defs/mountExchange" },
          "description": "What the call asked mounted sources, in order, and what they answered; a replay answers from these instead of the source."
        }
      }
    },
    "exchange": {
      "type": "object", "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 100, "maximum": 999 },
        "reason": { "type": "string" },
        "headers": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } },
        "body": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "blobs/<sha256> holding the body, after credentials were scrubbed; absent when empty." },
        "size": { "type": "integer", "minimum": 0 },
        "error": { "enum": ["resolve", "blocked", "connect", "timeout", "tls", "recv", "partial", "reset", "weird", "empty"], "description": "How the request failed instead of getting an answer; partial or reset with a status: the body ended early, and is what came." }
      }
    },
    "mountExchange": {
      "type": "object", "required": ["mount", "op", "path"],
      "properties": {
        "mount": { "$ref": "manifest.schema.json#/$defs/path", "description": "The mount point." },
        "op": { "enum": ["list", "stat", "read", "write", "delete", "rename", "mkdir"] },
        "path": { "$ref": "manifest.schema.json#/$defs/path", "description": "Within the source." },
        "to": { "$ref": "manifest.schema.json#/$defs/path", "description": "A rename's new path." },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/mountEntry" }, "description": "What a list answered." },
        "entry": { "oneOf": [{ "$ref": "#/$defs/mountEntry" }, { "type": "null" }], "description": "What a stat answered; null: missing." },
        "body": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "blobs/<sha256> holding what a read answered; absent when empty." },
        "size": { "type": "integer", "minimum": 0, "description": "A read's length." },
        "version": { "type": "string", "maxLength": 1024, "description": "The version a write, rename or mkdir returned." },
        "error": { "type": "string", "description": "The source's error instead of an answer, as the agent saw it (\"the source failed\" unless the source meant its text for the agent)." },
        "conflict": { "type": "boolean", "description": "The error was a version conflict." }
      }
    },
    "mountEntry": {
      "type": "object", "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "description": "As the source gave it; a reader skips names no file can have." },
        "type": { "enum": ["dir", "file"] },
        "size": { "type": "integer", "minimum": 0, "description": "Absent: not known until read." },
        "mtime": { "$ref": "manifest.schema.json#/$defs/time" },
        "version": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
