<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Topwater.Browser</PackageId>
    <Description>Mount a live web page in a Topwater shell as a sysfs-like tree: the agent reads the page, fills fields and clicks with cat and echo. Backed by Microsoft Playwright; every request the page makes goes through Topwater's web policy.</Description>
    <PackageTags>agents;llm;bash;shell;browser;playwright;web-automation</PackageTags>
    <!-- new in this release: there is no earlier package to compare with -->
    <DisablePackageBaselineValidation>true</DisablePackageBaselineValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Topwater lets this package use its internals: the web policy's request path (WebSession), OffContext, connector names -->
    <ProjectReference Include="..\Topwater\Topwater.csproj" />
  </ItemGroup>

</Project>
