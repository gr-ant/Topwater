<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Topwater</PackageId>
    <Description>Give your agent one bash tool backed by an in-process simulated Linux shell: a bash interpreter, an in-memory filesystem, ~100 standard utilities, and your own methods as commands.</Description>
    <PackageTags>agents;ai;llm;tool-use;function-calling;bash;shell;sandbox;simulation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- the web access tests reach a loopback server through the real connection path (WebAddresses' test hooks) -->
    <InternalsVisibleTo Include="Topwater.Tests" />
  </ItemGroup>

</Project>
